# EXAMPLE ONLY — copy to .env and fill in locally. Never commit the real thing.
#
# The account number is deliberately kept out of config/policy.toml because this
# repository is public. config.py reads it from the environment at runtime and
# Policy.require_account() fails closed when it is missing.
#
#   export QUANTTRADER_ACCOUNT=<your robinhood account number>
#
# Robinhood MCP credentials are NOT set here. They live in the macOS keychain
# under the "Codex MCP Credentials" service and are refreshed by `codex mcp login`.
QUANTTRADER_ACCOUNT=
